# AgentSeal frontend uses this URL to call the FastAPI backend.
NEXT_PUBLIC_AGENTSEAL_API_URL=http://127.0.0.1:8000

# ==============================
# AgentSeal UiPath Integration
# Local backend credentials only
# Never commit this file to GitHub
# ==============================

# From your UiPath Automation Cloud URL:
# Example: https://cloud.uipath.com/yousun/DefaultTenant/testmanager_
UIPATH_ORG_NAME=yousun
UIPATH_TENANT_NAME=DefaultTenant

# Created from UiPath Automation Cloud > Admin > External Applications
UIPATH_CLIENT_ID=your_client_id_here
UIPATH_CLIENT_SECRET=your_client_secret_here

# UiPath service URLs
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com/yousun/DefaultTenant/orchestrator_
UIPATH_TEST_MANAGER_URL=https://cloud.uipath.com/yousun/DefaultTenant/testmanager_

# Orchestrator values
UIPATH_FOLDER_ID=your_folder_id_here
UIPATH_RELEASE_KEY=your_process_release_key_here

# Test Manager/Test Cloud values
# From your screenshot, your project looks like AGS and test set key looks like AGS:12.
# Use these for proof/demo mapping first. Real API endpoints may later require GUID IDs.
UIPATH_TEST_PROJECT_ID=AGS
UIPATH_TEST_SET_ID=AGS:12